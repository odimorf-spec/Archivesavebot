# Токен бота от BotFather (@archivesavemessage_bot)
BOT_TOKEN=

# Пути
DB_PATH=data.db
MEDIA_PATH=media

# Юзербот (Telethon, отправка спама + автосохранение скрытой медии от имени
# пользователя). API_ID/API_HASH — https://my.telegram.org -> API development tools
API_ID=
API_HASH=
SESSION_NAME=save_session
# Пауза между сообщениями спама юзербота, сек (0.34 ≈ 3 сообщ/сек)
SPAM_DELAY_USERBOT=0.34
# Пауза между сообщениями спама через Bot API (когда юзербот не запущен)
SPAM_DELAY_API=0.34
