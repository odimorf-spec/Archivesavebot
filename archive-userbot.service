[Unit]
description=ARCHIVE userbot (Telethon)
after=network-online.target
wants=network-online.target

[Service]
type=simple
# ==== ИСПРАВЬ ПОД СЕБЯ ====
User=youruser
WorkingDirectory=/opt/autotg
EnvironmentFile=/opt/autotg/.env
# ==========================
Environment=TERM=xterm-256color
# Первый вход Telethon (телефон/код) делай вручную: "python userbot.py"
# в рабочей папке — сессия сохранится и дальше сервис зайдёт по ней сам.
ExecStart=/opt/autotg/venv/bin/python userbot.py
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty8
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
