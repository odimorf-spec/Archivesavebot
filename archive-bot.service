[Unit]
description=ARCHIVE Telegram bot (Bot API)
after=network-online.target
wants=network-online.target

[Service]
type=simple
# ==== ИСПРАВЬ ПОД СЕБЯ ====
User=youruser
WorkingDirectory=/opt/autotg
EnvironmentFile=/opt/autotg/.env
# ==========================
ExecStart=/opt/autotg/venv/bin/python bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
